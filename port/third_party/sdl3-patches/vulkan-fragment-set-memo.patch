+/* Dragon Rage: the memo's slot for the fragment samplers bound now; *found = 1 when it holds a set written with them */
+static DrFragMemo *DR_FragMemoSlot(VulkanCommandBuffer *commandBuffer, Uint32 layoutID, Uint32 count, bool *found)
+{
+    DescriptorSetCache *cache = commandBuffer->descriptorSetCache;
+    Uint64 h = 0xCBF29CE484222325ull ^ layoutID;
+    *found = false;
+    if (count > DR_FRAG_MEMO_SAMPLERS) {
+        return NULL;
+    }
+    if (cache->fragMemo == NULL) {
+        cache->fragMemo = SDL_calloc(DR_FRAG_MEMO_SIZE, sizeof(DrFragMemo));
+        if (cache->fragMemo == NULL) {
+            return NULL;
+        }
+    }
+    for (Uint32 i = 0; i < count; i += 1) {
+        h = (h ^ (Uint64)(uintptr_t)commandBuffer->fragmentSamplerBindings[i]) * 0x100000001B3ull;
+        h = (h ^ (Uint64)(uintptr_t)commandBuffer->fragmentSamplerTextureViewBindings[i]) * 0x100000001B3ull;
+    }
+    h ^= h >> 29;
+    for (Uint32 probe = 0; probe < 8; probe += 1) {
+        DrFragMemo *m = &cache->fragMemo[(h + probe) & (DR_FRAG_MEMO_SIZE - 1)];
+        if (m->gen != cache->fragMemoGen) {
+            return m; /* free: the set about to be written goes here */
+        }
+        if (m->layoutID == layoutID && m->count == count) {
+            bool same = true;
+            for (Uint32 i = 0; i < count; i += 1) {
+                if (m->samplers[i] != commandBuffer->fragmentSamplerBindings[i] ||
+                    m->views[i] != commandBuffer->fragmentSamplerTextureViewBindings[i]) {
+                    same = false;
+                    break;
+                }
+            }
+            if (same) {
+                *found = true;
+                return m;
+            }
+        }
+    }
+    return NULL; /* (the neighbourhood is full: written as before, not remembered) */
 }
 
