diff --git a/ps2xRuntime/src/lib/ps2_iop.cpp b/ps2xRuntime/src/lib/ps2_iop.cpp
--- a/ps2xRuntime/src/lib/ps2_iop.cpp
+++ b/ps2xRuntime/src/lib/ps2_iop.cpp
@@ -15,6 +15,40 @@
 #include <algorithm>
 #include <atomic>
 #include <iostream>
+#include <cstdlib>
+#include <sys/stat.h>
+#include <unistd.h>
+
+// [android] The disc image comes as /proc/self/fd/<n>: the app opens it through the system's file picker. Opening
+// that path again repeats the storage's permission check, which an app without storage permission fails (the image
+// in Download/, through MediaStore), so the image is read through the descriptor itself, with pread (no shared offset).
+int ps2xImageFd(const std::string &path)
+{
+    static const char kPrefix[] = "/proc/self/fd/";
+    if (path.compare(0, sizeof(kPrefix) - 1, kPrefix) != 0) return -1;
+    char *end = nullptr;
+    const long fd = std::strtol(path.c_str() + sizeof(kPrefix) - 1, &end, 10);
+    return end != path.c_str() + sizeof(kPrefix) - 1 && *end == '\0' && fd >= 0 ? static_cast<int>(fd) : -1;
+}
+
+bool ps2xImageRead(int fd, uint64_t offset, uint8_t *dst, size_t bytes)
+{
+    while (bytes > 0)
+    {
+        const ssize_t n = pread(fd, dst, bytes, static_cast<off_t>(offset));
+        if (n <= 0) return false;
+        dst += n; offset += static_cast<uint64_t>(n); bytes -= static_cast<size_t>(n);
+    }
+    return true;
+}
+
+bool ps2xImageSize(int fd, uint64_t &size)
+{
+    struct stat st{};
+    if (fstat(fd, &st) != 0) return false;
+    size = static_cast<uint64_t>(st.st_size);
+    return true;
+}
 
