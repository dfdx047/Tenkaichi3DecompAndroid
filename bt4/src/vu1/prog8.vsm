; ============================================================================================================
; VU1 program 8 (packet at 0x2C3080..0x2C3380, 94 instructions): ANIMATED STAGE OBJECTS. Two-matrix skinned
; (a node's matrix and the matrix it was entered with, blended by a per-vertex weight), vertex colours from the
; mesh, clip test. Used only through StgModel_DrawAnims (src/battle/stgm_a.c) -> Vu1Node_Animate / Vu1Node_Draw
; (src/sys/vu1_packet.c): one draw per node that has a mesh.
; It is program 2a (prog2a.vsm) with the stage's batch layout and a per-vertex colour: same skinning, same
; projection, same clip test, same register use.
;
; BUILDERS (src/sys/vu1_packet.c)
;   Vu1Pkt_LoadProg8()        MPG upload, FLUSHE, UNPACK V4-32 of 0x12 quadwords to address 0, BASE 0x12, OFFSET
;                             0x1F7. StgModel_DrawAnims fills 10..17. No MSCAL.
;   Vu1Pkt_CallProg8(node)    FLUSHE, UNPACK V4-32 of 0xA quadwords to address 0 (so 0..9; 10..17 stay), MSCALF 0,
;                             BASE, OFFSET, then DMA "call" of node->vif. Vu1Node_Draw fills 0..9.
;
; ENTRY POINTS (instruction addresses)
;    0   MSCALF 0 from Vu1Pkt_CallProg8: per-node setup, stops at the E bit at 13 (14 still runs).
;   15   where the first MSCNT of the node's VIF stream resumes: one batch, ends at the E bit after the xgkick.
;   92   where every later MSCNT resumes: `b` back to 15.
;   (inferred) that the streams use MSCNT, one per batch: the model data was not looked at here.
;
; VU MEMORY, constants (quadword addresses)
;    0.. 3   matrix A (columns) = Vu1Node.world  (the node's matrix after its own position / rotation)
;    4.. 7   matrix B (columns) = Vu1Node.parent (the matrix on entry to the node)
;    8       offset subtracted from the position before A = Vu1Node.unkD0 (copy of unk30)
;    9       offset subtracted from the position before B = Vu1Node.unkE0 (copy of unk40)
;            (inferred) the pivots of the node and of its parent in the mesh's rest pose
;   10..13   matrix S (columns): world -> GS screen coordinates (VU0 vf24-27, Vu0Screen_StoreMtx)
;   14..17   matrix C (columns): world -> clip-test space (VU0 vf20-23, Vu0Clip_StoreMtx)
;   The two input buffers (VIF double buffer) are 0x12.. and 0x12 + 0x1F7 = 0x209.. .
;
; INPUT BATCH at TOP (xtop)
;   +0   copied to the output    (inferred) GIF tag "one A+D register"
;   +1   copied to the output    TEX0 value: Vu1Node_OrFlags finds the header as the VIF code 0x6C038000 (UNPACK
;                                V4-32, 3 quadwords at TOPS + 0) and ORs the texture and CLUT block numbers
;                                (0x3480, 0x3700 << 5) into the first two words of this quadword
;   +2   copied to the output; the low 15 bits of its first word are the vertex count (the NLOOP field of the
;        primitive GIF tag; (inferred) registers ST, RGBAQ, XYZ)
;   +3   vertices, 3 quadwords each:
;          +0  position x y z, w = blend weight (1 = all matrix A, 0 = all matrix B)
;          +1  colour r g b a as floats
;          +2  s, t, 1 (z is whatever the mesh has there; it is multiplied by 1/w like s and t)
;   The count must be at least 1 (the loop tests at the bottom).
;
; OUTPUT GIF packet at TOP + 255 (vi2 = TOP + 3 + 0xFC), sent with xgkick
;   +0, +1, +2   input +0, +1, +2 unchanged
;   +3 + 3n      vertex n:  +0  s/w, t/w, 1/w, (input w)                 -> ST / Q
;                           +1  the vertex colour as integers (ftoi0)    -> RGBAQ
;                           +2  ftoi4 of S p / w: x, y in 12.4 fixed point, z through the same conversion;
;                               4th word = ftoi4 of w / w (16, or 15 after rounding), or 0x8000 (ADC: do not
;                               draw the triangle this vertex completes) when the clip test failed
;   Size limit (inferred from the addresses): the output starts 255 into a 503-quadword buffer, so at most 81
;   vertices per batch fit without running into the other buffer.
;
; REGISTERS in the vertex loop
;   vf1-4    A (0..3) while the next position is transformed, S (10..13) while the current one is projected;
;            reloaded from memory twice per vertex
;   vf5-8    B (4..7), then C (14..17); same scheme
;   vf30 / vf31  the two offsets (8 / 9)
;   vf19     position being skinned (w = weight)          vf28 / vf29  A (pos - ofsA) / B (pos - ofsB)
;   vf20     skinned position                 vf24  S p, then divided by w      vf25  C p (clip test only)
;   vf22     texture coordinates              vf21  colour, floats then integers
;   vf26, vf27, vf25  batch header quadwords +0, +1, +2 (before the loop)
;   vi2  output packet    vi3  input vertex pointer    vi7  output vertex pointer    vi10  vertices left
;   vi1  clip result (fcand)    vi11 = 0x7FFF (count mask)    vi13 = 0x8000 (ADC bit)
;   The loop is software-pipelined: the A half of vertex n + 1 runs at the bottom of vertex n's iteration.
;
; Labels: `*_batch`, `*_vertex` and `*_next` are the branch targets; `*_setup` and `*_resume` are added names for
; the addresses the VIF enters at (no instruction refers to them). The generated listing also had an `Lnnn:` in
; front of many other instructions; those came from the disassembler taking a "branch target" from the low bits
; of every lower word, not only of branches, and were targets of nothing, so they are removed.
; ============================================================================================================

.vif 0x00000000
.mpg 0

; ---- 0: per-node setup (MSCALF 0) --------------------------------------------------------------------------
; Preloads A, B and the offsets; nothing is computed.
p8_setup:
    nop                                | lq.xyzw vf1, 0(vi0)            ; vf1-4 = matrix A (mem 0..3)
    nop                                | lq.xyzw vf2, 1(vi0)
    nop                                | lq.xyzw vf3, 2(vi0)
    nop                                | lq.xyzw vf4, 3(vi0)
    nop                                | lq.xyzw vf5, 4(vi0)            ; vf5-8 = matrix B (mem 4..7)
    nop                                | lq.xyzw vf6, 5(vi0)
    nop                                | lq.xyzw vf7, 6(vi0)
    nop                                | lq.xyzw vf8, 7(vi0)
    nop                                | iaddiu vi11, vi0, 0x7fff       ; vi11 = 0x7FFF
    nop                                | iaddi vi13, vi11, 1            ; vi13 = 0x8000, the ADC bit
    nop                                | lq.xyzw vf30, 8(vi0)           ; vf30 = ofsA
    nop                                | lq.xyzw vf31, 9(vi0)           ; vf31 = ofsB
    nop                                | nop
    nop                                | nop [E]                        ; end of the MSCALF run (the next line still runs)
    nop                                | nop

; ---- 15: one batch (first MSCNT lands here, later ones through the `b` at the end) ----------------------------
p8_batch:
    nop                                | xtop vi3                       ; vi3 = TOP
    nop                                | lqi.xyzw vf26, (vi3++)         ; header +0
    nop                                | lqi.xyzw vf27, (vi3++)         ; header +1; vi3 = TOP + 2
    nop                                | ilwr.x vi10, (vi3)             ; vi10 = first word of header +2 (NLOOP, EOP)
    nop                                | lqi.xyzw vf25, (vi3++)         ; header +2; vi3 = TOP + 3 = first vertex
    nop                                | lq.xyzw vf19, 0(vi3)           ; position of vertex 0
    nop                                | iaddiu vi11, vi0, 0x7fff
    nop                                | iand vi10, vi10, vi11          ; vi10 = vertex count (drops the EOP bit)
    nop                                | iaddiu vi2, vi3, 0xfc          ; vi2 = output packet = TOP + 255
    sub.xyzw vf28, vf19, vf30          | sq.xyzw vf26, 0(vi2)           ; vf28 = pos - ofsA; out +0 = header +0
    sub.xyzw vf29, vf19, vf31          | sq.xyzw vf27, 1(vi2)           ; vf29 = pos - ofsB; out +1 = header +1
    nop                                | sq.xyzw vf25, 2(vi2)           ; out +2 = header +2 (the primitive tag)
    nop                                | iaddiu vi7, vi2, 0x3           ; vi7 = first output vertex
    ; vertex 0: vf28 = A (pos - ofsA), w taken as 1. vf5-8 = B again (they hold C after a previous batch).
    mulax.xyzw acc, vf1, vf28x         | lq.xyzw vf5, 4(vi0)
    madday.xyzw acc, vf2, vf28y        | lq.xyzw vf6, 5(vi0)
    maddaz.xyzw acc, vf3, vf28z        | lq.xyzw vf7, 6(vi0)
    maddw.xyzw vf28, vf4, vf0w         | lq.xyzw vf8, 7(vi0)            ; vf28 = A (pos - ofsA)

; ---- 32: vertex loop ------------------------------------------------------------------------------------------
; On entry: vf19 = this vertex's position, vf28 = its A half, vf29 = pos - ofsB, vf1-4 = A, vf5-8 = B.
p8_vertex:
    mulax.xyzw acc, vf5, vf29x         | nop
    madday.xyzw acc, vf6, vf29y        | nop
    maddaz.xyzw acc, vf7, vf29z        | nop
    maddw.xyzw vf29, vf8, vf0w         | nop                            ; vf29 = B (pos - ofsB)
    nop                                | nop
    nop                                | nop
    nop                                | nop
    sub.xyzw vf20, vf28, vf29          | nop                            ; A half - B half
    nop                                | nop
    nop                                | lq.xyzw vf1, 10(vi0)           ; vf1-4 = matrix S (mem 10..13)
    nop                                | lq.xyzw vf2, 11(vi0)
    mulw.xyzw vf20, vf20, vf19w        | lq.xyzw vf3, 12(vi0)           ; (A - B) * weight
    nop                                | lq.xyzw vf4, 13(vi0)
    nop                                | lq.xyzw vf5, 14(vi0)           ; vf5-8 = matrix C (mem 14..17)
    nop                                | lq.xyzw vf6, 15(vi0)
    add.xyzw vf20, vf29, vf20          | lq.xyzw vf7, 16(vi0)           ; vf20 = B + (A - B) * weight: skinned position
    nop                                | lq.xyzw vf8, 17(vi0)
    nop                                | nop
    nop                                | nop
    mulax.xyzw acc, vf1, vf20x         | nop
    madday.xyzw acc, vf2, vf20y        | nop
    maddaz.xyzw acc, vf3, vf20z        | nop
    maddw.xyzw vf24, vf4, vf0w         | nop                            ; vf24 = S p (p.w taken as 1)
    nop                                | nop
    mulax.xyzw acc, vf5, vf20x         | nop
    madday.xyzw acc, vf6, vf20y        | nop
    maddaz.xyzw acc, vf7, vf20z        | div q, vf0w, vf24w             ; q = 1 / (S p).w
    maddw.xyzw vf25, vf8, vf0w         | lq.xyzw vf22, 2(vi3)           ; vf25 = C p; vf22 = s, t, 1
    nop                                | nop
    nop                                | nop
    nop                                | nop
    clip.xyz vf25, vf25                | nop                            ; clip flags of C p: x, y, z against +-w
    nop                                | nop
    mulq.xyzw vf24, vf24               | lq.xyzw vf1, 0(vi0)            ; vf24 = S p / w; vf1-4 = matrix A again
    mulq.xyz vf22, vf22                | lq.xyzw vf2, 1(vi0)            ; vf22 = s/w, t/w, 1/w
    nop                                | lq.xyzw vf3, 2(vi0)
    nop                                | lq.xyzw vf4, 3(vi0)
    nop                                | fcand vi1, 0x3ffff             ; vi1 = 1 if one of the last 3 vertices was outside
    nop                                | sq.xyzw vf22, 0(vi7)           ; out vertex +0 = texture coordinates
    nop                                | lq.xyzw vf21, 1(vi3)           ; vf21 = this vertex's colour, floats
    nop                                | iaddiu vi3, vi3, 0x3           ; next input vertex
    ftoi4.xyzw vf29, vf24              | lq.xyzw vf19, 0(vi3)           ; vf29 = ftoi4 (S p / w); vf19 = next position
    nop                                | lq.xyzw vf5, 4(vi0)            ; vf5-8 = matrix B again
    nop                                | lq.xyzw vf6, 5(vi0)
    nop                                | lq.xyzw vf7, 6(vi0)
    sub.xyzw vf28, vf19, vf30          | sq.xyzw vf29, 2(vi7)           ; next: pos - ofsA; out vertex +2 = XYZ of this one
    sub.xyzw vf29, vf19, vf31          | lq.xyzw vf8, 7(vi0)            ; next: pos - ofsB (vf29 was stored one line up)
    ftoi0.xyzw vf21, vf21              | nop                            ; colour as integers
    nop                                | nop
    mulax.xyzw acc, vf1, vf28x         | iaddi vi10, vi10, -1           ; vertices left
    madday.xyzw acc, vf2, vf28y        | iaddiu vi7, vi7, 0x3           ; next output vertex
    maddaz.xyzw acc, vf3, vf28z        | sq.xyzw vf21, -2(vi7)          ; out vertex +1 (of the one just done) = colour
    maddw.xyzw vf28, vf4, vf0w         | ibeq vi1, vi0, p8_next         ; next: vf28 = A (pos - ofsA); all inside: skip the store
    nop                                | nop
    nop                                | isw.w vi13, -1(vi7)            ; outside: XYZ 4th word = 0x8000 (ADC)
p8_next:
    nop                                | ibne vi10, vi0, p8_vertex      ; more vertices: loop
    nop                                | nop

; ---- batch done: send the packet and stop until the next MSCNT ---------------------------------------------
    nop                                | xgkick vi2                     ; GIF packet at vi2 -> GS
    nop                                | nop [E]                        ; end of this run
    nop                                | nop
p8_resume:
    nop                                | b p8_batch                     ; the next MSCNT resumes here
    nop                                | nop

; padding of the packet (VIF NOPs)
.vif 0x00000000
.vif 0x00000000
