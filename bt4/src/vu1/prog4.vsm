; prog4 -- VU1 microprogram 4: the stage and other static geometry (399 instructions, 0x2C04F0..0x2C1180).
; Notes with the full description: docs/systems/vu1/prog4_prog5.md. "(inferred)" = not confirmed from code.
;
; WHAT IT DRAWS
;   Triangle strips with one colour and one texture coordinate per vertex, no lighting: transform, perspective
;   divide, and a full six-plane triangle clipper for the triangles that leave the clip volume.
;
; WHO USES IT (src/sys/vu1_packet.c, src/battle/stgm_a.c)
;   Vu1Pkt_LoadProg4(mtx)   uploads the program and 12 quadwords of constants to VU address 0, BASE 0x8D, OFFSET 0x1B4.
;                           Called by StgModel_Draw with mtx = the view's matrix at +0x100.
;   Vu1Pkt_CallProg4(chain) FLUSHE, MSCALF 0, BASE / OFFSET again, then calls the mesh's DMA chain, which holds the
;                           UNPACKs and MSCNTs of the object header and of every batch.
;
; ENTRY POINTS
;   init (0)            MSCALF 0: loads the constants into registers, sets the stack pointer. Draws nothing.
;   object_header (15)  the first MSCNT after it: one quadword at TOP is copied to VU address 30.
;   batch (21)          every later MSCNT: one batch at TOP = one triangle strip. (After the first batch the MSCNT
;                       resumes at batch_resume (69), which branches back to batch.)
;
; VU MEMORY (quadword addresses)
;   0x000..0x003  screen matrix: position -> GS screen coordinates times w (Vu0Screen_StoreMtx)        vf1..vf4
;   0x004..0x007  clip matrix: position -> clip space, visible when |x|, |y|, |z| <= |w| (Vu0Clip_StoreMtx)  vf5..vf8
;   0x008..0x00B  clip space -> screen matrix (the mtx argument; View_BuildProjection builds it: a scale on
;                 the diagonal, 2048 / 2048 / z centre in the last column). Only the clipper's fans use it.  vf9..vf12
;   0x00C..0x01D  not used
;   0x01E         GIF tag of the fan packet = the object header quadword; the program only rewrites its first
;                 word (NLOOP and EOP). (inferred) PRIM = triangle fan, registers ST, RGBAQ, XYZ2.
;   0x01F..0x03C  fan vertices, three quadwords each (ST, RGBAQ, XYZ2); room for 10, at most 9 are needed
;   0x03D..0x064  clipper polygon A, three quadwords per vertex: clip position, colour (floats), texcoord
;   0x065..0x08C  clipper polygon B, same layout (the two are used in turn, one plane each)
;   0x08D..       TOP of the first buffer; 0x241 (BASE + OFFSET) is TOP of the second. From TOP:
;                   +0x00  the input batch (below)
;                   +0xDD  the output packet (below)
;   ..0x3FF       stack, grows down from 0x400 (vi14); six quadwords while the clipper runs
;
; INPUT BATCH (at TOP)
;   +0  GIF tag: one A+D register, EOP        +1  its data (the texture, per the port's notes)
;   +2  GIF tag of the strip: NLOOP = vertex count n (bits 0..14 of the first word), registers ST, RGBAQ, XYZ2
;   +3  n vertices, three quadwords each:  +0 position (x, y, z, w)   +1 colour r, g, b, a as floats (0..255)
;                                          +2 texture coordinates (s, t, q; q is 1 in the data (inferred))
;
; OUTPUT (two or more XGKICKs per batch)
;   TOP+0xDD  +0, +1  copy of input +0, +1; kicked first, on its own (its tag has EOP)
;             +2      copy of input +2
;             +3      n vertices, three quadwords each: ST = (s, t, q) / w;  RGBAQ = colour as integers;
;                     XYZ2 = screen position / w as 12.4 fixed point (ftoi4 of x, y, z, w; the GIF's XYZ2 packing takes
;                     z from bit 4 up, so z arrives as an integer). Bit 15 of the fourth word is ADC: the clipper
;                     sets it on the last vertex of a triangle it rejects or replaces, so the GS skips that triangle.
;             Kicked from +2 when all vertices are done.
;   0x01E     one fan packet per clipped triangle, kicked as soon as it is built (so before the strip it came from).
;
; REGISTERS, MAIN LOOP
;   vf1..vf12  the three matrices (never written after init)      vf31  zero
;   vf20  position of the next vertex     vf19  texcoord      vf21  colour
;   vf22, vf23, vf24  clip positions of the last three vertices (oldest first)
;   vf25  screen position (already computed for the next vertex when the loop comes round)
;   vf26, vf27, vf28  RGBAQ, XYZ2, ST as stored            q  1 / w of the vertex being stored
;   vi2   output packet           vi3  input cursor: the vertex being stored (its position was read a round earlier)
;   vi7   output cursor: the vertex being stored is at vi7 - 4 (ST), - 3 (RGBAQ), - 2 (XYZ2) once vi7 has advanced
;   vi10  vertices left           vi13  0x8000 (EOP bit of a GIF tag, ADC bit of XYZ2)
;   vi6, vi5  "outside the clip volume" flag (0 / 1) of the newest and the previous vertex;
;   vi4   that flag summed over the triangle's three vertices; > 0 sends the triangle to the clipper.
;         All three start at -2, so the first two vertices of a strip (no triangle yet) cannot trigger it.
;   vi14  stack pointer
;
; REGISTERS, CLIPPER (everything the main loop needs is pushed on the stack around clip_triangle)
;   vi15  return address of clip_triangle     vi2  return address of clip_edge and close_polygon
;   vi1   return address of intersect and emit_fan, and the clipping flags inside clip_edge
;   vi5, vi6  flag masks of the current plane for the edge's first / second vertex     vi7  component selector
;   vi8, vi9  source / destination polygon cursors        vi10  edges left      vi11  vertices written
;   vi12  loop counter in intersect             vf30x  sign of the current plane (-1 or +1)
;   vf17, vf18, vf19  edge start A (position, colour, texcoord)    vf21, vf22, vf23  edge end B
;   vf25, vf26, vf27  the intersection vertex                      vf28  centroid; vf29x  interpolation factor t
;   emit_fan: vi3 input cursor, vi7 output cursor, vi2 = 0x1E, vf20 / vf22 / vf21 position / colour / texcoord,
;             vf25 screen position, vf26 / vf28 / vf29 XYZ2 / ST / RGBAQ.
;
; Labels that the disassembler made for addresses nothing branches to have been removed.
.vif 0x00000000
.mpg 0

; ---- MSCALF 0: constants
init:
    nop                                | lq.xyzw vf1, 0(vi0)                ; vf1..vf4 = VU 0..3: screen matrix
    nop                                | lq.xyzw vf2, 1(vi0)
    nop                                | lq.xyzw vf3, 2(vi0)
    nop                                | lq.xyzw vf4, 3(vi0)
    nop                                | lq.xyzw vf5, 4(vi0)                ; vf5..vf8 = VU 4..7: clip matrix
    nop                                | lq.xyzw vf6, 5(vi0)
    nop                                | lq.xyzw vf7, 6(vi0)
    nop                                | lq.xyzw vf8, 7(vi0)
    nop                                | lq.xyzw vf9, 8(vi0)                ; vf9..vf12 = VU 8..11: clip -> screen matrix (fans only)
    nop                                | lq.xyzw vf10, 9(vi0)
    nop                                | lq.xyzw vf11, 10(vi0)
    nop                                | lq.xyzw vf12, 11(vi0)
    nop                                | iaddiu vi14, vi0, 0x400            ; vi14 = stack pointer
    nop                                | nop [E]                            ; end of the MSCALF 0 run (the next line still executes)
    nop                                | nop

; ---- first MSCNT: the object header
object_header:
    nop                                | xtop vi1                           ; vi1 = TOP
    mulx.xyzw vf31, vf31, vf0x         | lq.xyzw vf30, 0(vi1)               ; vf31 = 0 (vf0x is 0) | vf30 = the header quadword
    nop                                | sq.xyzw vf30, 30(vi0)              ; VU 30 = GIF tag of the fan packet
    nop                                | nop
    nop                                | nop [E]                            ; end; the next MSCNT starts at batch
    nop                                | nop

; ---- every later MSCNT: one batch = one triangle strip
batch:
    nop                                | xtop vi1                           ; vi1 = TOP
    nop                                | lq.xyzw vf17, 0(vi1)               ; vf17 = +0: A+D GIF tag
    nop                                | lq.xyzw vf18, 1(vi1)               ; vf18 = +1: its data
    nop                                | iaddiu vi1, vi1, 0x2               ; vi1 -> +2: GIF tag of the strip
    nop                                | iaddiu vi3, vi1, 0x1               ; vi3 -> +3: vertex 0
    nop                                | lq.xyzw vf20, 0(vi3)               ; vf20 = position of vertex 0
    nop                                | iaddiu vi11, vi0, 0x7fff
    nop                                | iaddi vi13, vi11, 1                ; vi13 = 0x8000
    nop                                | ilwr.x vi10, (vi1)
    nop                                | iand vi10, vi10, vi11              ; vi10 = NLOOP = vertex count
    mulax.xyzw acc, vf1, vf20x         | lq.xyzw vf19, 0(vi1)               ; acc .. vf25 = screen matrix * position | vf19 = GIF tag of the strip
    madday.xyzw acc, vf2, vf20y        | iaddiu vi2, vi3, 0xda              ; vi2 = TOP + 3 + 0xDA: output packet
    maddaz.xyzw acc, vf3, vf20z        | iaddi vi4, vi0, -2                 ; vi4, vi5, vi6 = -2: no triangle yet
    maddw.xyzw vf25, vf4, vf20w        | iaddi vi5, vi0, -2
    nop                                | iaddi vi6, vi0, -2
    nop                                | div q, vf0w, vf25w                 ; q = 1 / w
    nop                                | sq.xyzw vf17, 0(vi2)               ; output +0, +1, +2 = the three header quadwords
    nop                                | sq.xyzw vf18, 1(vi2)
    nop                                | sq.xyzw vf19, 2(vi2)
    nop                                | iaddiu vi7, vi2, 0x4               ; vi7 = output cursor
    nop                                | move.xyzw vf22, vf0                ; clip position history = (0, 0, 0, 1)
    nop                                | move.xyzw vf23, vf0
    nop                                | move.xyzw vf24, vf0
    nop                                | xgkick vi2                         ; kick output +0 (tag and data only: EOP): the texture
    nop                                | iaddiu vi2, vi2, 0x2               ; vi2 -> output +2: the strip packet, kicked after the loop

; ---- per vertex (20 instructions). The screen position of this vertex (vf25) and q = 1 / w were started in
; the previous round (or in the batch setup); this round stores it and starts the next vertex.
vertex_loop:
    mulax.xyzw acc, vf5, vf20x         | move.xyzw vf22, vf23               ; acc .. vf24 = clip matrix * position | shift the clip position history
    madday.xyzw acc, vf6, vf20y        | move.xyzw vf23, vf24
    maddaz.xyzw acc, vf7, vf20z        | lq.xyzw vf19, 2(vi3)               ; vf19 = texcoord
    maddw.xyzw vf24, vf8, vf20w        | lq.xyzw vf21, 1(vi3)               ; vf24 = clip position | vf21 = colour (floats)
    clip.xyz vf22, vf22                | lq.xyzw vf20, 3(vi3)               ; clip judgement, oldest vertex of the triangle | vf20 = position of the next vertex
    clip.xyz vf23, vf23                | iadd vi4, vi0, vi5                 ; clip judgement, middle vertex | vi4 = flag of the vertex two back
    mulq.xyzw vf25, vf25               | iadd vi5, vi0, vi6                 ; vf25 = screen position / w | vi5 = flag of the previous vertex
    mulq.xyz vf28, vf19                | iaddiu vi3, vi3, 0x3               ; vf28 = (s, t, q) / w
    clip.xyz vf24, vf24                | iaddiu vi7, vi7, 0x3               ; clip judgement, this vertex
    mulax.xyzw acc, vf1, vf20x         | iaddi vi10, vi10, -1               ; acc .. vf25 = screen matrix * next position | vi10 = vertices left
    ftoi4.xyzw vf27, vf25              | iadd vi4, vi4, vi5                 ; vf27 = 12.4 fixed point
    madday.xyzw acc, vf2, vf20y        | sq.xyzw vf28, -4(vi7)              ; store ST
    ftoi0.xyzw vf26, vf21              | fcand vi1, 0x3f                    ; vf26 = colour as integers | vi1 = 1 if this vertex is outside any plane
    maddaz.xyzw acc, vf3, vf20z        | iadd vi6, vi0, vi1                 ; vi6 = flag of this vertex
    maddw.xyzw vf25, vf4, vf20w        | iadd vi4, vi4, vi6                 ; vf25 = next screen position | vi4 = outside vertices in the triangle
    nop                                | sq.xyzw vf27, -2(vi7)              ; store XYZ2
    nop                                | ibgtz vi4, triangle_outside        ; any outside: clipper
    nop                                | sq.xyzw vf26, -3(vi7)              ; (delay slot) store RGBAQ
vertex_next:
    nop                                | ibne vi10, vi0, vertex_loop
    nop                                | div q, vf0w, vf25w                 ; (delay slot) q = 1 / w of the next vertex
    nop                                | xgkick vi2                         ; kick the strip
    nop                                | nop [E]                            ; end of this batch
    nop                                | nop
batch_resume:
    nop                                | b batch                            ; the next MSCNT resumes here
    nop                                | nop

; ---- the newest triangle has at least one vertex outside the clip volume.
; The clipping flags hold the judgements of vf22, vf23, vf24 (bits 12..17, 6..11, 0..5; per vertex: bit 0 x > +|w|,
; 1 x < -|w|, 2 y > +|w|, 3 y < -|w|, 4 z > +|w|, 5 z < -|w|). fcor gives 1 when flags | mask is all ones, i.e. when
; the three bits the mask leaves open are all set: all three vertices outside the same plane -> drop the triangle.
triangle_outside:
    nop                                | fcor vi1, 0xff7df7                 ; vi1 = 1 if all three vertices have y < -w
    nop                                | ibne vi1, vi0, triangle_drop
    nop                                | nop
    nop                                | fcor vi1, 0xffbefb                 ; vi1 = 1 if all three vertices have y > +w
    nop                                | ibne vi1, vi0, triangle_drop
    nop                                | nop
    nop                                | fcor vi1, 0xffdf7d                 ; vi1 = 1 if all three vertices have x < -w
    nop                                | ibne vi1, vi0, triangle_drop
    nop                                | nop
    nop                                | fcor vi1, 0xffefbe                 ; vi1 = 1 if all three vertices have x > +w
    nop                                | ibne vi1, vi0, triangle_drop
    nop                                | nop
    nop                                | fcor vi1, 0xfdf7df                 ; vi1 = 1 if all three vertices have z < -w
    nop                                | ibne vi1, vi0, triangle_drop
    nop                                | nop
    nop                                | fcor vi1, 0xfefbef                 ; vi1 = 1 if all three vertices have z > +w
    nop                                | ibne vi1, vi0, triangle_drop
    nop                                | nop

; ---- the triangle crosses the volume: clip it. vf28 = centroid of the three clip positions, vf25..vf27 = the
; vertices relative to it (clip_triangle enlarges the triangle by 0.5% with these). Pushed: vf20, vf23, vf24, vf25
; and vi2, vi3, vi5 / vi6, vi7, vi10 as two quadwords. vf22 is not saved (the loop overwrites it first).
triangle_clip:
    adda.xyzw acc, vf22, vf23          | loi 0x3F800000 [I]   ; 1 -- acc = v0 + v1 | I = 1
    maddi.xyzw vf28, vf24              | loi 0x3EAAAAAA [I]   ; 0.333333313 -- vf28 = v0 + v1 + v2 | I = 1/3
    nop                                | sqd.xyzw vf20, (--vi14)            ; push vf20, vf23, vf24, vf25
    nop                                | sqd.xyzw vf23, (--vi14)
    nop                                | sqd.xyzw vf24, (--vi14)
    muli.xyzw vf28, vf28               | sqd.xyzw vf25, (--vi14)            ; vf28 = centroid
    nop                                | isubiu vi14, vi14, 0x1
    nop                                | iswr.x vi2, (vi14)                 ; push vi2, vi3, vi5
    nop                                | iswr.y vi3, (vi14)
    sub.xyzw vf25, vf22, vf28          | iswr.z vi5, (vi14)                 ; vf25, vf26, vf27 = v0, v1, v2 - centroid
    sub.xyzw vf26, vf23, vf28          | isubiu vi14, vi14, 0x1
    sub.xyzw vf27, vf24, vf28          | iswr.x vi6, (vi14)                 ; push vi6, vi7, vi10
    nop                                | iswr.y vi7, (vi14)
    nop                                | iswr.z vi10, (vi14)
    nop                                | bal vi15, clip_triangle
    nop                                | nop
    nop                                | ilwr.x vi6, (vi14)                 ; pop vi6, vi7, vi10
    nop                                | ilwr.y vi7, (vi14)
    nop                                | ilwr.z vi10, (vi14)
    nop                                | iaddiu vi14, vi14, 0x1
    nop                                | ilwr.x vi2, (vi14)                 ; pop vi2, vi3, vi5
    nop                                | ilwr.y vi3, (vi14)
    nop                                | ilwr.z vi5, (vi14)
    nop                                | iaddiu vi14, vi14, 0x1
    mulx.xyzw vf31, vf31, vf0x         | lqi.xyzw vf25, (vi14++)            ; vf31 = 0 again (nothing in the clipper changes it) | pop vf25, vf24, vf23, vf20
    nop                                | lqi.xyzw vf24, (vi14++)
    nop                                | lqi.xyzw vf23, (vi14++)
    nop                                | lqi.xyzw vf20, (vi14++)

; ---- the triangle is not drawn by the strip: ADC bit on its last vertex
triangle_drop:
    nop                                | isw.w vi13, -2(vi7)                ; ADC bit (0x8000 in the fourth word) of the XYZ2 just stored
    nop                                | b vertex_next
    nop                                | nop

; ---- clip_triangle (return address vi15): clips one triangle against the six planes of the clip volume and
; sends what is left as a triangle fan.
; In: vf28 = centroid, vf25..vf27 = the three clip positions minus the centroid; vi3 / vi7 = main loop cursors
; (already past the newest vertex). Method: Sutherland-Hodgman. The polygon is kept closed (first vertex repeated
; at the end) and goes A -> B -> A ... once per plane, in the order z = -w, z = +w, x = -w, x = +w, y = -w, y = +w.
; The six blocks differ only in their constants.
clip_triangle:
    mulaw.xyzw acc, vf28, vf0w         | loi 0x3F80A3D7 [I]   ; 1.005 -- acc = centroid | I = 1.005
    maddi.xyzw vf22, vf25              | iaddiu vi8, vi0, 0x3d              ; vf22 = centroid + 1.005 * (v0 - centroid) | vi8 = polygon A
    mulaw.xyzw acc, vf28, vf0w         | iaddiu vi9, vi0, 0x65              ; vi9 = polygon B
    maddi.xyzw vf23, vf26              | nop                                ; vf23 = the same for v1
    mulaw.xyzw acc, vf28, vf0w         | nop
    maddi.xyzw vf24, vf27              | nop                                ; vf24 = the same for v2
    nop                                | nop
    nop                                | sq.xyzw vf22, 0(vi8)               ; polygon A: positions of v0, v1, v2, v0 (closed), at +0, +3, +6, +9
    nop                                | sq.xyzw vf23, 3(vi8)
    nop                                | sq.xyzw vf24, 6(vi8)
    nop                                | sq.xyzw vf22, 9(vi8)
    nop                                | lq.xyzw vf22, -7(vi3)              ; input texcoords of the three vertices (vi3 is already past the newest)
    nop                                | lq.xyzw vf23, -4(vi3)
    nop                                | lq.xyzw vf24, -1(vi3)
    nop                                | sq.xyzw vf22, 2(vi8)               ; -> polygon A +2, +5, +8, +11
    nop                                | sq.xyzw vf23, 5(vi8)
    nop                                | sq.xyzw vf24, 8(vi8)
    nop                                | sq.xyzw vf22, 11(vi8)
    nop                                | lq.xyzw vf22, -9(vi7)              ; their colours as just stored in the output packet (integers)
    nop                                | lq.xyzw vf23, -6(vi7)
    nop                                | lq.xyzw vf24, -3(vi7)
    itof0.xyzw vf22, vf22              | nop                                ; back to floats
    itof0.xyzw vf23, vf23              | nop
    itof0.xyzw vf24, vf24              | nop
    nop                                | sq.xyzw vf22, 1(vi8)               ; -> polygon A +1, +4, +7, +10
    nop                                | sq.xyzw vf23, 4(vi8)
    nop                                | sq.xyzw vf24, 7(vi8)
    nop                                | sq.xyzw vf22, 10(vi8)

; ---- plane 1 of 6: z = -w. Polygon A -> polygon B.
    nop                                | iaddiu vi5, vi0, 0x800             ; vi5 = "outside this plane" bit of the edge's first vertex (older clip judgement)
    nop                                | iaddiu vi6, vi0, 0x20              ; vi6 = the same bit of its second vertex (newest judgement)
    nop                                | iaddiu vi7, vi0, 0x2               ; vi7 = mr32 rotations that bring the component to x (0 = x, 1 = y, 2 = z)
    nop                                | iaddiu vi8, vi0, 0x3d              ; vi8 = source polygon (A)
    nop                                | iaddiu vi9, vi0, 0x65              ; vi9 = destination polygon (B)
    nop                                | iaddiu vi10, vi0, 0x3              ; vi10 = edges to do (the triangle's three)
    subw.x vf30, vf0, vf0w             | iaddiu vi11, vi0, 0x0              ; vf30x = plane sign (-1) | vi11 = vertices written = 0
    nop                                | lqi.xyzw vf21, (vi8++)             ; vf21, vf22, vf23 = first source vertex (position, colour, texcoord)
    nop                                | lqi.xyzw vf22, (vi8++)
    nop                                | lqi.xyzw vf23, (vi8++)
clip_zneg_loop:
    nop                                | isubiu vi10, vi10, 0x1
    nop                                | bal vi2, clip_edge                 ; one edge
    nop                                | nop
    nop                                | ibne vi10, vi0, clip_zneg_loop
    nop                                | nop
    nop                                | iaddiu vi8, vi0, 0x65              ; vi8 = start of the destination polygon
    nop                                | bal vi2, close_polygon             ; append its first vertex again (closes it)
    nop                                | nop
    nop                                | ibeq vi11, vi0, clip_triangle_ret  ; nothing left of the triangle
    nop                                | nop

; ---- plane 2 of 6: z = +w. Polygon B -> polygon A.
    nop                                | iaddiu vi5, vi0, 0x400             ; vi5 = "outside this plane" bit of the edge's first vertex (older clip judgement)
    nop                                | iaddiu vi6, vi0, 0x10              ; vi6 = the same bit of its second vertex (newest judgement)
    nop                                | iaddiu vi7, vi0, 0x2               ; vi7 = mr32 rotations that bring the component to x (0 = x, 1 = y, 2 = z)
    nop                                | iaddiu vi8, vi0, 0x65              ; vi8 = source polygon (B)
    nop                                | iaddiu vi9, vi0, 0x3d              ; vi9 = destination polygon (A)
    nop                                | iadd vi10, vi0, vi11               ; vi10 = edges to do = vertices the last plane wrote
    addw.x vf30, vf0, vf0w             | iaddiu vi11, vi0, 0x0              ; vf30x = plane sign (+1) | vi11 = vertices written = 0
    nop                                | lqi.xyzw vf21, (vi8++)             ; vf21, vf22, vf23 = first source vertex (position, colour, texcoord)
    nop                                | lqi.xyzw vf22, (vi8++)
    nop                                | lqi.xyzw vf23, (vi8++)
clip_zpos_loop:
    nop                                | isubiu vi10, vi10, 0x1
    nop                                | bal vi2, clip_edge                 ; one edge
    nop                                | nop
    nop                                | ibne vi10, vi0, clip_zpos_loop
    nop                                | nop
    nop                                | iaddiu vi8, vi0, 0x3d              ; vi8 = start of the destination polygon
    nop                                | bal vi2, close_polygon             ; append its first vertex again (closes it)
    nop                                | nop
    nop                                | ibeq vi11, vi0, clip_triangle_ret  ; nothing left of the triangle
    nop                                | nop

; ---- plane 3 of 6: x = -w. Polygon A -> polygon B.
    nop                                | iaddiu vi5, vi0, 0x80              ; vi5 = "outside this plane" bit of the edge's first vertex (older clip judgement)
    nop                                | iaddiu vi6, vi0, 0x2               ; vi6 = the same bit of its second vertex (newest judgement)
    nop                                | iaddiu vi7, vi0, 0x0               ; vi7 = mr32 rotations that bring the component to x (0 = x, 1 = y, 2 = z)
    nop                                | iaddiu vi8, vi0, 0x3d              ; vi8 = source polygon (A)
    nop                                | iaddiu vi9, vi0, 0x65              ; vi9 = destination polygon (B)
    nop                                | iadd vi10, vi0, vi11               ; vi10 = edges to do = vertices the last plane wrote
    subw.x vf30, vf0, vf0w             | iaddiu vi11, vi0, 0x0              ; vf30x = plane sign (-1) | vi11 = vertices written = 0
    nop                                | lqi.xyzw vf21, (vi8++)             ; vf21, vf22, vf23 = first source vertex (position, colour, texcoord)
    nop                                | lqi.xyzw vf22, (vi8++)
    nop                                | lqi.xyzw vf23, (vi8++)
clip_xneg_loop:
    nop                                | isubiu vi10, vi10, 0x1
    nop                                | bal vi2, clip_edge                 ; one edge
    nop                                | nop
    nop                                | ibne vi10, vi0, clip_xneg_loop
    nop                                | nop
    nop                                | iaddiu vi8, vi0, 0x65              ; vi8 = start of the destination polygon
    nop                                | bal vi2, close_polygon             ; append its first vertex again (closes it)
    nop                                | nop
    nop                                | ibeq vi11, vi0, clip_triangle_ret  ; nothing left of the triangle
    nop                                | nop

; ---- plane 4 of 6: x = +w. Polygon B -> polygon A.
    nop                                | iaddiu vi5, vi0, 0x40              ; vi5 = "outside this plane" bit of the edge's first vertex (older clip judgement)
    nop                                | iaddiu vi6, vi0, 0x1               ; vi6 = the same bit of its second vertex (newest judgement)
    nop                                | iaddiu vi7, vi0, 0x0               ; vi7 = mr32 rotations that bring the component to x (0 = x, 1 = y, 2 = z)
    nop                                | iaddiu vi8, vi0, 0x65              ; vi8 = source polygon (B)
    nop                                | iaddiu vi9, vi0, 0x3d              ; vi9 = destination polygon (A)
    nop                                | iadd vi10, vi0, vi11               ; vi10 = edges to do = vertices the last plane wrote
    addw.x vf30, vf0, vf0w             | iaddiu vi11, vi0, 0x0              ; vf30x = plane sign (+1) | vi11 = vertices written = 0
    nop                                | lqi.xyzw vf21, (vi8++)             ; vf21, vf22, vf23 = first source vertex (position, colour, texcoord)
    nop                                | lqi.xyzw vf22, (vi8++)
    nop                                | lqi.xyzw vf23, (vi8++)
clip_xpos_loop:
    nop                                | isubiu vi10, vi10, 0x1
    nop                                | bal vi2, clip_edge                 ; one edge
    nop                                | nop
    nop                                | ibne vi10, vi0, clip_xpos_loop
    nop                                | nop
    nop                                | iaddiu vi8, vi0, 0x3d              ; vi8 = start of the destination polygon
    nop                                | bal vi2, close_polygon             ; append its first vertex again (closes it)
    nop                                | nop
    nop                                | ibeq vi11, vi0, clip_triangle_ret  ; nothing left of the triangle
    nop                                | nop

; ---- plane 5 of 6: y = -w. Polygon A -> polygon B.
    nop                                | iaddiu vi5, vi0, 0x200             ; vi5 = "outside this plane" bit of the edge's first vertex (older clip judgement)
    nop                                | iaddiu vi6, vi0, 0x8               ; vi6 = the same bit of its second vertex (newest judgement)
    nop                                | iaddiu vi7, vi0, 0x1               ; vi7 = mr32 rotations that bring the component to x (0 = x, 1 = y, 2 = z)
    nop                                | iaddiu vi8, vi0, 0x3d              ; vi8 = source polygon (A)
    nop                                | iaddiu vi9, vi0, 0x65              ; vi9 = destination polygon (B)
    nop                                | iadd vi10, vi0, vi11               ; vi10 = edges to do = vertices the last plane wrote
    subw.x vf30, vf0, vf0w             | iaddiu vi11, vi0, 0x0              ; vf30x = plane sign (-1) | vi11 = vertices written = 0
    nop                                | lqi.xyzw vf21, (vi8++)             ; vf21, vf22, vf23 = first source vertex (position, colour, texcoord)
    nop                                | lqi.xyzw vf22, (vi8++)
    nop                                | lqi.xyzw vf23, (vi8++)
clip_yneg_loop:
    nop                                | isubiu vi10, vi10, 0x1
    nop                                | bal vi2, clip_edge                 ; one edge
    nop                                | nop
    nop                                | ibne vi10, vi0, clip_yneg_loop
    nop                                | nop
    nop                                | iaddiu vi8, vi0, 0x65              ; vi8 = start of the destination polygon
    nop                                | bal vi2, close_polygon             ; append its first vertex again (closes it)
    nop                                | nop
    nop                                | ibeq vi11, vi0, clip_triangle_ret  ; nothing left of the triangle
    nop                                | nop

; ---- plane 6 of 6: y = +w. Polygon B -> polygon A.
    nop                                | iaddiu vi5, vi0, 0x100             ; vi5 = "outside this plane" bit of the edge's first vertex (older clip judgement)
    nop                                | iaddiu vi6, vi0, 0x4               ; vi6 = the same bit of its second vertex (newest judgement)
    nop                                | iaddiu vi7, vi0, 0x1               ; vi7 = mr32 rotations that bring the component to x (0 = x, 1 = y, 2 = z)
    nop                                | iaddiu vi8, vi0, 0x65              ; vi8 = source polygon (B)
    nop                                | iaddiu vi9, vi0, 0x3d              ; vi9 = destination polygon (A)
    nop                                | iadd vi10, vi0, vi11               ; vi10 = edges to do = vertices the last plane wrote
    addw.x vf30, vf0, vf0w             | iaddiu vi11, vi0, 0x0              ; vf30x = plane sign (+1) | vi11 = vertices written = 0
    nop                                | lqi.xyzw vf21, (vi8++)             ; vf21, vf22, vf23 = first source vertex (position, colour, texcoord)
; (not a boundary of the program: one VIF MPG code carries at most 256 instructions)
.vif 0x00000000
.mpg 256
    nop                                | lqi.xyzw vf22, (vi8++)
    nop                                | lqi.xyzw vf23, (vi8++)
clip_ypos_loop:
    nop                                | isubiu vi10, vi10, 0x1
    nop                                | bal vi2, clip_edge                 ; one edge
    nop                                | nop
    nop                                | ibne vi10, vi0, clip_ypos_loop
    nop                                | nop
    nop                                | iaddiu vi8, vi0, 0x3d              ; vi8 = start of the destination polygon
    nop                                | bal vi2, close_polygon             ; append its first vertex again (closes it)
    nop                                | nop
    nop                                | ibeq vi11, vi0, clip_triangle_ret  ; nothing left of the triangle
    nop                                | nop

; ---- all six planes done: the result is polygon A, vi11 vertices
    nop                                | iaddiu vi8, vi0, 0x3d
    nop                                | iaddiu vi9, vi0, 0x65
    nop                                | iadd vi10, vi0, vi11               ; vi10 = vertex count
    nop                                | iaddiu vi11, vi0, 0x0
    nop                                | bal vi1, emit_fan                  ; emit_fan
    nop                                | nop
clip_triangle_ret:
    nop                                | jr vi15
    nop                                | nop

; ---- close_polygon (return address vi2): copies the vertex at vi8 (the polygon's first) to vi9 (its end),
; so that the next pass finds the edge last -> first. Leaves that vertex in vf21, vf22, vf23.
close_polygon:
    nop                                | lq.xyzw vf21, 0(vi8)
    nop                                | lq.xyzw vf22, 1(vi8)
    nop                                | lq.xyzw vf23, 2(vi8)
    nop                                | sqi.xyzw vf21, (vi9++)
    nop                                | sqi.xyzw vf22, (vi9++)
    nop                                | sqi.xyzw vf23, (vi9++)
    nop                                | jr vi2
    nop                                | nop

; ---- clip_edge (return address vi2): one polygon edge A -> B against the current plane.
; In: vf21, vf22, vf23 = A (left by the previous call or the plane setup), vi8 -> B in the source polygon,
;     vi5 / vi6 = the plane's bit for A / B in the clipping flags, vi7 and vf30x for intersect.
; Writes to the destination polygon (vi9), counting in vi11:
;     A inside,  B inside:   A                 A outside, B inside:   the intersection
;     A inside,  B outside:  A, intersection   A outside, B outside:  nothing
; Out: vf21, vf22, vf23 = B.
clip_edge:
    add.xyzw vf17, vf31, vf21          | lqi.xyzw vf21, (vi8++)             ; vf17 = A position (vf31 is 0: a move in the upper half) | vf21 = B position
    add.xyzw vf18, vf31, vf22          | lqi.xyzw vf22, (vi8++)             ; vf18 = A colour | vf22 = B colour
    add.xyzw vf19, vf31, vf23          | lqi.xyzw vf23, (vi8++)             ; vf19 = A texcoord | vf23 = B texcoord
    nop                                | nop
    clip.xyz vf17, vf17                | nop                                ; clip judgement of A ...
    clip.xyz vf21, vf21                | nop                                ; ... then of B
    nop                                | nop
    nop                                | nop
    nop                                | nop
    nop                                | fcget vi1                          ; vi1 = clipping flags: bits 0..5 B, bits 6..11 A
    nop                                | iand vi4, vi1, vi5                 ; A outside?
    nop                                | nop
    nop                                | ibeq vi4, vi0, edge_a_inside       ; no
    nop                                | nop
    nop                                | iand vi4, vi1, vi6                 ; A outside. B outside?
    nop                                | nop
    nop                                | ibeq vi4, vi0, edge_enters         ; no: the edge enters
    nop                                | nop
    nop                                | b clip_edge_ret                    ; both outside: write nothing
    nop                                | nop
edge_enters:
    nop                                | bal vi1, intersect
    nop                                | nop
    nop                                | sqi.xyzw vf25, (vi9++)             ; write the intersection
    nop                                | sqi.xyzw vf26, (vi9++)
    nop                                | sqi.xyzw vf27, (vi9++)
    nop                                | iaddiu vi11, vi11, 0x1
    nop                                | b clip_edge_ret
    nop                                | nop
edge_a_inside:
    nop                                | iand vi4, vi1, vi6                 ; B outside?
    nop                                | nop
    nop                                | ibeq vi4, vi0, edge_both_inside    ; no: both inside
    nop                                | nop
    nop                                | bal vi1, intersect                 ; the edge leaves
    nop                                | nop
    nop                                | sqi.xyzw vf17, (vi9++)             ; write A ...
    nop                                | sqi.xyzw vf18, (vi9++)
    nop                                | sqi.xyzw vf19, (vi9++)
    nop                                | sqi.xyzw vf25, (vi9++)             ; ... and the intersection
    nop                                | sqi.xyzw vf26, (vi9++)
    nop                                | sqi.xyzw vf27, (vi9++)
    nop                                | iaddiu vi11, vi11, 0x2
    nop                                | b clip_edge_ret
    nop                                | nop
edge_both_inside:
    nop                                | sqi.xyzw vf17, (vi9++)             ; write A
    nop                                | sqi.xyzw vf18, (vi9++)
    nop                                | sqi.xyzw vf19, (vi9++)
    nop                                | iaddiu vi11, vi11, 0x1
clip_edge_ret:
    nop                                | jr vi2
    nop                                | nop

; ---- intersect (return address vi1): the point where edge A -> B crosses the current plane.
; d = component - sign * w is the signed distance to the plane in clip space (component chosen by vi7, sign in
; vf30x). t = dA / (dA - dB); result = A + t * (B - A) for all four components of position, colour and texcoord.
; In: vf17, vf18, vf19 = A; vf21, vf22, vf23 = B. Out: vf25, vf26, vf27 = the new vertex. Uses vf29x, vi12, q.
intersect:
    mulx.w vf25, vf17, vf30x           | nop                                ; vf25w = sign * wA
    mulx.w vf26, vf21, vf30x           | nop                                ; vf26w = sign * wB
    nop                                | iadd vi12, vi0, vi7                ; vi12 = rotations
    subw.xyzw vf25, vf17, vf25w        | nop                                ; vf25 = A - sign * wA (every component)
    subw.xyzw vf26, vf21, vf26w        | nop                                ; vf26 = B - sign * wB
    nop                                | nop
intersect_rotate:
    nop                                | ibeq vi12, vi0, intersect_rotated
    nop                                | nop
    nop                                | mr32.xyzw vf25, vf25               ; (x, y, z, w) <- (y, z, w, x)
    nop                                | mr32.xyzw vf26, vf26
    nop                                | isubiu vi12, vi12, 0x1
    nop                                | b intersect_rotate
    nop                                | nop
intersect_rotated:
    sub.xyz vf27, vf26, vf25           | nop                                ; vf27x = dB - dA
    nop                                | nop
    nop                                | nop
    nop                                | nop
    nop                                | div q, vf25x, vf27x                ; q = dA / (dB - dA)
    nop                                | waitq
    addq.x vf29, vf0                   | nop                                ; vf29x = q
    abs.x vf29, vf29                   | nop                                ; t = |q| = dA / (dA - dB), 0..1
    sub.xyzw vf25, vf21, vf17          | nop                                ; B - A: position, colour, texcoord
    sub.xyzw vf26, vf22, vf18          | nop
    sub.xyzw vf27, vf23, vf19          | nop
    mulx.xyzw vf25, vf25, vf29x        | nop                                ; * t
    mulx.xyzw vf26, vf26, vf29x        | nop
    mulx.xyzw vf27, vf27, vf29x        | nop
    add.xyzw vf25, vf25, vf17          | nop                                ; + A
    add.xyzw vf26, vf26, vf18          | nop
    add.xyzw vf27, vf27, vf19          | nop
    nop                                | jr vi1
    nop                                | nop

; ---- emit_fan (return address vi1): sends the polygon at vi8 (vi10 vertices) as one GIF packet from VU 30.
; Per vertex: screen = (clip -> screen matrix) * clip position, / w, to 12.4; colour to integers;
; texcoord * 1 / w. Same vertex format as the strip (ST, RGBAQ, XYZ2).
emit_fan:
    nop                                | lq.xyzw vf20, 0(vi8)               ; vf20 = clip position of polygon vertex 0
    nop                                | iadd vi3, vi0, vi8                 ; vi3 = input cursor
    nop                                | nop
    nop                                | iaddiu vi2, vi0, 0x1e              ; vi2 = the fan packet
    mulax.xyzw acc, vf9, vf20x         | nop                                ; acc .. vf25 = clip -> screen matrix * position
    madday.xyzw acc, vf10, vf20y       | nop
    maddaz.xyzw acc, vf11, vf20z       | isw.x vi13, 0(vi2)                 ; tag: NLOOP = 0, EOP
    maddw.xyzw vf25, vf12, vf20w       | iaddiu vi7, vi2, 0x2               ; vi7 = output cursor
    nop                                | iadd vi11, vi10, vi13              ; vi11 = vertex count | EOP
    nop                                | nop
    nop                                | xgkick vi2                         ; kick the empty tag: (inferred) waits for the previous kick of this buffer to finish before rewriting it
    nop                                | div q, vf0w, vf25w                 ; q = 1 / w
    nop                                | isw.x vi11, 0(vi2)                 ; tag: NLOOP = vertex count, EOP
fan_loop:
    nop                                | lq.xyzw vf22, 1(vi3)               ; vf22 = colour
    nop                                | lq.xyzw vf20, 3(vi3)               ; vf20 = position of the next vertex
    nop                                | lq.xyzw vf21, 2(vi3)               ; vf21 = texcoord
    nop                                | iaddiu vi7, vi7, 0x3
    ftoi0.xyzw vf29, vf22              | iaddiu vi3, vi3, 0x3               ; vf29 = colour as integers
    mulax.xyzw acc, vf9, vf20x         | nop                                ; acc .. vf25 = next screen position
    mulq.xyzw vf26, vf25               | nop                                ; vf26 = screen position / w
    madday.xyzw acc, vf10, vf20y       | nop
    maddaz.xyzw acc, vf11, vf20z       | sq.xyzw vf29, -3(vi7)              ; store RGBAQ
    mulq.xyz vf28, vf21                | iaddi vi10, vi10, -1               ; vf28 = texcoord / w | vi10 = vertices left
    ftoi4.xyzw vf26, vf26              | nop                                ; vf26 = 12.4 fixed point
    maddw.xyzw vf25, vf12, vf20w       | nop
    nop                                | nop
    nop                                | sq.xyzw vf28, -4(vi7)              ; store ST
    nop                                | sq.xyzw vf26, -2(vi7)              ; store XYZ2
    nop                                | ibne vi10, vi0, fan_loop
    nop                                | div q, vf0w, vf25w                 ; (delay slot) q = 1 / w of the next vertex
    nop                                | xgkick vi2                         ; kick the fan
    nop                                | nop
    nop                                | jr vi1
    nop                                | nop
.vif 0x00000000
.vif 0x00000000

