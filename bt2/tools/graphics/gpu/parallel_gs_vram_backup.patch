+const Vulkan::Buffer &GSInterface::get_vram_buffer() const
+{
+	return renderer.get_vram_buffer();
+}
+
+const Vulkan::Buffer &GSInterface::get_clut_buffer() const
+{
+	return renderer.get_clut_buffer();
+}
+
+void GSInterface::invalidate_vram()
+{
+	PageRect page_rect = {};
+	page_rect.base_page = 0;
+	page_rect.page_width = vram_size / PageSize;
+	page_rect.page_height = 1;
+	page_rect.page_stride = page_rect.page_width;
+	page_rect.block_mask = UINT32_MAX;
+	page_rect.write_mask = UINT32_MAX;
+	tracker.mark_external_write(page_rect);
+}
