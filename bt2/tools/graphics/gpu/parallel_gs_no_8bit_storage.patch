+uint transfer_u24(uvec2 bda, uint index)
+{
+	uint byte_addr = index * 3u;
+	uint shift = (byte_addr & 3u) * 8u;
+	uint value = TRANSFER32(bda).data[byte_addr >> 2u] >> shift;
+	if (shift > 8u)
